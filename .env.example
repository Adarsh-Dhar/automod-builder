# Server keys (keep secret)
# For production (Gemini)
GEMINI_API_KEY=

# For development (GitHub Models)
# Set your GitHub Models API token
GITHUB_API_KEY=
# Optional: Override the default model ID
GITHUB_MODEL_ID=openai/gpt-4.1
# Optional: Override the default endpoint
GITHUB_MODEL_ENDPOINT=https://models.github.ai/inference/chat/completions

# Optional: control runtime
NODE_ENV=development
