{
  "name": "rulestage",
  "version": "0.0.0",
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "generativelanguage.googleapis.com"
      ]
    },
    "reddit": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Open RuleStage",
        "description": "Open the Automod builder and simulator",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/rank-settings"
      }
    ]
  },
  "triggers": {
    "onModAction": "/internal/triggers/on-mod-action",
    "onPostSubmit": "/internal/triggers/on-post-submit",
    "onCommentSubmit": "/internal/triggers/on-comment-submit",
    "onInstall": "/internal/triggers/on-install",
    "onUninstall": "/internal/triggers/on-uninstall"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "AutoModDemo"
  }
}